<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/songFragment">

    <fragment
        android:id="@+id/songFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.activity.main.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_songFragment_to_songMenuBottom"
            app:destination="@id/songMenuBottom" />
        <action
            android:id="@+id/action_songFragment_to_detailAlbumFragment"
            app:destination="@id/detailAlbumFragment" />
        <action
            app:popExitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_left"
            app:enterAnim="@anim/slide_in_right"
            android:id="@+id/action_songFragment_to_detailTypeFragment"
            app:destination="@id/detailTypeFragment" />
    </fragment>




    <dialog
        android:id="@+id/songMenuBottom"
        android:name="com.ahuynh.muzimusicapp.ui.component.activity.main.home.HomeMenuBottom"
        android:label="SongMenuBottom" >
        <argument
            android:name="song"
            app:argType="com.ahuynh.muzimusicapp.data.model.Song" />
    </dialog>

    <fragment
        android:id="@+id/detailAlbumFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.activity.main.home.detail.DetailAlbumFragment"
        android:label="fragment_detail_album"
        tools:layout="@layout/fragment_detail_album" >
        <argument
            android:name="album"
            app:argType="com.ahuynh.muzimusicapp.data.model.Album" />
    </fragment>
    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.activity.main.playlist.PlaylistFragment"
        android:label="fragment_playlist"
        tools:layout="@layout/fragment_playlist" >
        <action
            android:id="@+id/action_playlistFragment_to_playlistModelBottomSheet"
            app:destination="@id/playlistModelBottomSheet" />
        <action
            android:id="@+id/action_playlistFragment_to_detailPlaylistFragment"
            app:destination="@id/detailPlaylistFragment" />
    </fragment>
    <dialog
        android:id="@+id/playlistModelBottomSheet"
        android:name="com.ahuynh.muzimusicapp.ui.component.activity.main.playlist.detail.PlaylistModelBottomSheet"
        android:label="PlaylistModelBottomSheet" >
        <argument
            android:name="playlist"
            app:argType="com.ahuynh.muzimusicapp.data.model.Playlist" />
    </dialog>
    <fragment
        android:id="@+id/detailTypeFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.activity.main.home.detail.DetailTypeFragment"
        android:label="fragment_detail_type"
        tools:layout="@layout/fragment_detail_type" >
        <argument
            android:name="type"
            app:argType="com.ahuynh.muzimusicapp.data.model.Type" />
    </fragment>
    <fragment
        android:id="@+id/detailPlaylistFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.activity.main.playlist.detail.DetailPlaylistFragment"
        android:label="fragment_detail_playlist"
        tools:layout="@layout/fragment_detail_playlist" >
        <argument
            android:name="playlist"
            app:argType="com.ahuynh.muzimusicapp.data.model.Playlist" />
    </fragment>
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.activity.main.setting.SettingFragment"
        android:label="fragment_setting"
        tools:layout="@layout/fragment_setting" />
</navigation>