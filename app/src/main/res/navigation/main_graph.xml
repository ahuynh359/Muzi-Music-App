<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_songMenuBottom"
            app:destination="@id/songMenuBottom" />
        <action
            android:id="@+id/action_homeFragment_to_detailAlbumFragment"
            app:destination="@id/detailAlbumFragment" />
    </fragment>




    <dialog
        android:id="@+id/songMenuBottom"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.menu.HomeMenuBottom"
        android:label="SongMenuBottom" >
        <argument
            android:name="song"
            app:argType="com.ahuynh.muzimusicapp.data.model.Song" />
    </dialog>

    <fragment
        android:id="@+id/detailAlbumFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.album.DetailAlbumFragment"
        android:label="fragment_detail_album"
        tools:layout="@layout/fragment_detail_album" >
        <argument
            android:name="album"
            app:argType="com.ahuynh.muzimusicapp.data.model.Album" />
    </fragment>

    <fragment
        android:id="@+id/detailPlaylistFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.playlist.detail.DetailPlaylistFragment"
        android:label="fragment_detail_playlist"
        tools:layout="@layout/fragment_detail_playlist" >
        <argument
            android:name="playlist"
            app:argType="com.ahuynh.muzimusicapp.data.model.Playlist" />
    </fragment>
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.setting.SettingFragment"
        android:label="fragment_setting"
        tools:layout="@layout/fragment_setting" >
        <action
            android:id="@+id/action_settingFragment_to_playlistAddDialog"
            app:destination="@id/playlistAddDialog" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.search.fragment.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_searchFragment_to_detailTypeFragment"
            app:destination="@id/detailTypeFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />
        <action
            app:popExitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_left"
            app:enterAnim="@anim/slide_in_right"
            android:id="@+id/action_profileFragment_to_settingFragment"
            app:destination="@id/settingFragment" />
        <action

            android:id="@+id/action_profileFragment_to_playlistFragment"
            app:destination="@id/playlistFragment" />
    </fragment>
    <dialog
        android:id="@+id/changePasswordFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.changpassword.ChangePasswordFragment"
        android:label="fragment_change_password"
        tools:layout="@layout/fragment_change_password" />
    <dialog
        android:id="@+id/detailTypeFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.type.DetailTypeFragment"
        android:label="fragment_detail_type"
        tools:layout="@layout/fragment_detail_type" >
        <argument
            android:name="type"
            app:argType="com.ahuynh.muzimusicapp.data.model.Type" />
    </dialog>
    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.playlist.PlaylistFragment"
        android:label="fragment_playlist"
        tools:layout="@layout/fragment_playlist" />
    <dialog
        android:id="@+id/playlistAddDialog"
        android:name="com.ahuynh.muzimusicapp.ui.component.main.playlist.detail.PlaylistAddDialog"
        android:label="fragment_playlist_add_dialog"
        tools:layout="@layout/fragment_playlist_add_dialog" />
</navigation>