<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/manage_album_graph"
    app:startDestination="@id/manageAlbumFragment">

    <fragment
        android:id="@+id/manageAlbumFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.album.ManageAlbumFragment"
        android:label="fragment_manage_album"
        tools:layout="@layout/fragment_manage_album" >
        <action
            app:enterAnim="@anim/bottom_to_top"
            app:exitAnim="@anim/top_to_bottom"
            app:popEnterAnim="@anim/bottom_to_top"
            app:popExitAnim="@anim/top_to_bottom"
            android:id="@+id/action_manageAlbumFragment_to_addAlbumFragment"
            app:destination="@id/addAlbumFragment" />
        <action
            app:enterAnim="@anim/bottom_to_top"
            app:exitAnim="@anim/top_to_bottom"
            app:popEnterAnim="@anim/bottom_to_top"
            app:popExitAnim="@anim/top_to_bottom"
            android:id="@+id/action_manageAlbumFragment_to_manageAlbumDetailFragment"
            app:destination="@id/manageAlbumDetailFragment" />
        <action
            android:id="@+id/action_manageAlbumFragment_to_manageAlbumMenu"
            app:destination="@id/manageAlbumMenu" />
    </fragment>
    <fragment
        android:id="@+id/addAlbumFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.album.add_album.AddAlbumFragment"
        android:label="fragment_add_album"
        tools:layout="@layout/fragment_add_album" />
    <fragment
        android:id="@+id/manageAlbumDetailFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.album.detail_manage_album.ManageAlbumDetailFragment"
        android:label="fragment_manage_album_detail"
        tools:layout="@layout/fragment_manage_album_detail" >
        <argument
            android:name="album"
            app:argType="com.ahuynh.muzimusicapp.data.model.Album" />
    </fragment>
    <dialog
        android:id="@+id/manageAlbumMenu"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.album.menu.ManageAlbumMenu"
        android:label="fragment_manage_album_menu"
        tools:layout="@layout/fragment_manage_album_menu" >
        <argument
            android:name="album"
            app:argType="com.ahuynh.muzimusicapp.data.model.Album" />
    </dialog>

</navigation>