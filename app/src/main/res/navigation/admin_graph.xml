<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/admin_graph"
    app:startDestination="@id/manageUserFragment">

    <fragment
        android:id="@+id/manageUserFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.user.ManageUserFragment"
        android:label="fragment_manage_user"
        tools:layout="@layout/fragment_manage_user" >
        <action
            android:id="@+id/action_manageUserFragment_to_manageUserDetail"
            app:destination="@id/manageUserDetail" />
        <action
            app:popExitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_left"
            app:enterAnim="@anim/slide_in_right"
            android:id="@+id/action_manageUserFragment_to_searchManageUserFragment"
            app:destination="@id/searchManageUserFragment" />
        <action
            app:popExitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_left"
            app:enterAnim="@anim/slide_in_right"
            android:id="@+id/action_manageUserFragment_to_addUserFragment"
            app:destination="@id/addUserFragment" />
    </fragment>
    <dialog
        android:id="@+id/manageUserDetail"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.user.detail_manage_user.ManageUserDetailFragment"
        android:label="fragment_manage_user_detail"
        tools:layout="@layout/fragment_manage_user_detail" >
        <argument
            android:name="user"
            app:argType="com.ahuynh.muzimusicapp.data.model.User" />
        <action
            android:id="@+id/action_manageUserDetail_to_manageUserMenu"
            app:destination="@id/manageUserMenu" />
    </dialog>
    <dialog
        android:id="@+id/manageUserMenu"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.user.menu.ManageUserMenu"
        android:label="ManageUserMenu" >
        <argument
            android:name="user"
            app:argType="com.ahuynh.muzimusicapp.data.model.User" />
    </dialog>
    <fragment
        android:id="@+id/searchManageUserFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.user.search.SearchManageUserFragment"
        android:label="fragment_search_manage_user"
        tools:layout="@layout/fragment_search_manage_user" />
    <fragment
        app:popExitAnim="@anim/slide_out_right"
        app:popEnterAnim="@anim/slide_in_left"
        app:exitAnim="@anim/slide_out_left"
        app:enterAnim="@anim/slide_in_right"
        android:id="@+id/addUserFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.user.add_user.AddUserFragment"
        android:label="fragment_add_user"
        tools:layout="@layout/fragment_add_user" />
    <fragment
        android:id="@+id/manageSongFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.song.ManageSongFragment"
        android:label="fragment_manage_song"
        tools:layout="@layout/fragment_manage_song" >
        <action
            app:popExitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_left"
            app:enterAnim="@anim/slide_in_right"
            android:id="@+id/action_manageSongFragment_to_searchManageSongFragment"
            app:destination="@id/searchManageSongFragment" />
    </fragment>
    <fragment
        app:popExitAnim="@anim/slide_out_right"
        app:popEnterAnim="@anim/slide_in_left"
        app:exitAnim="@anim/slide_out_left"
        app:enterAnim="@anim/slide_in_right"
        android:id="@+id/searchManageSongFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.song.search.SearchManageSongFragment"
        android:label="fragment_search_manage_song"
        tools:layout="@layout/fragment_search_manage_song" />
    <fragment
        android:id="@+id/manageTypeFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.type.ManageTypeFragment"
        android:label="fragment_manage_type"
        tools:layout="@layout/fragment_manage_type" >
        <action
            app:popExitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_left"
            app:enterAnim="@anim/slide_in_right"
            android:id="@+id/action_manageTypeFragment_to_searchManageTypeFragment"
            app:destination="@id/searchManageTypeFragment" />
        <action
            app:popExitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_left"
            app:enterAnim="@anim/slide_in_right"
            android:id="@+id/action_manageTypeFragment_to_addTypeFragment"
            app:destination="@id/addTypeFragment" />
        <action
            app:popExitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_left"
            app:enterAnim="@anim/slide_in_right"
            android:id="@+id/action_manageTypeFragment_to_manageTypeDetailFragment"
            app:destination="@id/manageTypeDetailFragment" />

    </fragment>
    <fragment
        android:id="@+id/searchManageTypeFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.type.search.SearchManageTypeFragment"
        android:label="fragment_search_manage_type"
        tools:layout="@layout/fragment_search_manage_type" >
        <action
            android:id="@+id/action_searchManageTypeFragment_to_manageTypeDetailFragment"
            app:destination="@id/manageTypeDetailFragment" />
        <action
            android:id="@+id/action_searchManageTypeFragment_to_manageTypeMenu"
            app:destination="@id/manageTypeMenu" />
    </fragment>
    <fragment
        android:id="@+id/addTypeFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.type.add_type.AddTypeFragment"
        android:label="fragment_add_type"
        tools:layout="@layout/fragment_add_type" />
    <fragment

        android:id="@+id/manageTypeDetailFragment"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.type.detail_manage_type.ManageTypeDetailFragment"
        android:label="fragment_manage_type_detail"
        tools:layout="@layout/fragment_manage_type_detail" >
        <argument
            android:name="type"
            app:argType="com.ahuynh.muzimusicapp.data.model.Type" />
    </fragment>
    <dialog
        android:id="@+id/manageTypeMenu"
        android:name="com.ahuynh.muzimusicapp.ui.component.admin.type.Type.ManageTypeMenu"
        android:label="ManageTypeMenu" >
        <argument
            android:name="type"
            app:argType="com.ahuynh.muzimusicapp.data.model.Type" />
    </dialog>

</navigation>