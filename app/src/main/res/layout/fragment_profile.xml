<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_linear_blue"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.component.main.profile.ProfileFragment">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/_32dp"
        android:layout_height="@dimen/_32dp"
        android:layout_marginStart="@dimen/_24dp"
        android:layout_marginTop="@dimen/_34dp"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_back" />
    <com.google.android.material.imageview.ShapeableImageView
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/imv_avatar"
        android:layout_width="@dimen/_123dp"
        android:layout_height="@dimen/_123dp"
        android:src="@drawable/one_direction"
        android:theme="@style/circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back"

        />
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/pg_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@id/imv_avatar"
        app:layout_constraintEnd_toEndOf="@id/imv_avatar"
        app:layout_constraintStart_toStartOf="@id/imv_avatar"
        app:layout_constraintTop_toTopOf="@id/imv_avatar" />



    <androidx.appcompat.widget.AppCompatImageButton
        app:layout_constraintBottom_toBottomOf="@id/imv_avatar"
        app:layout_constraintEnd_toEndOf="@id/imv_avatar"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_edit_circle"
        android:id="@+id/btn_edit"
        android:layout_width="30dp"
        android:layout_height="30dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:textAllCaps="false"
        android:layout_marginTop="37dp"
        android:paddingHorizontal="10dp"
        android:textSize="12sp"
        android:fontFamily="@font/bold"
        android:text="Edit Password"
        android:background="@drawable/bg_btn_black"
        app:layout_constraintTop_toBottomOf="@id/imv_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/btn_edit_password"
        android:layout_width="wrap_content"
        android:layout_height="40dp"/>
    <androidx.recyclerview.widget.RecyclerView
        tools:itemCount="5"
        tools:listitem="@layout/item_user_list"
        android:layout_marginHorizontal="@dimen/_20dp"
        android:layout_marginTop="@dimen/_20dp"
        app:layout_constraintTop_toBottomOf="@id/btn_edit_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/rcy_user_list"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>