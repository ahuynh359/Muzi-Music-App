<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">




    <TextView
        android:layout_marginTop="10dp"
        android:textSize="15sp"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:fontFamily="@font/bold"
        android:text="Singer name" />

    <com.google.android.material.textfield.TextInputLayout
        android:background="#1E1E1E"
        android:id="@+id/til_des"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/_5dp"
        android:hint="Type Singer Name"
        app:hintTextColor="@color/silver">

        <com.google.android.material.textfield.TextInputEditText

            android:id="@+id/edt_singer"
            style="@style/CustomEdittextLight"
            android:background="@drawable/bg_edt_type" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:visibility="gone"
        android:layout_marginTop="@dimen/_10dp"
        android:text="Do not leave empty"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/tv_leave_empty"
        android:fontFamily="@font/medium"
        android:textColor="@color/red"
        />






</LinearLayout>