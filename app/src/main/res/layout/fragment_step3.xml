<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.component.admin.song.add_song.step.Step3Fragment">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_album"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_24dp"
        android:layout_marginTop="@dimen/_34dp"
        android:fontFamily="@font/bold"
        android:text="@string/choose_album"
        android:textSize="@dimen/_26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/edt_album"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_25dp"
        android:layout_marginTop="@dimen/_10dp"
        android:background="@drawable/edittext_background"
        android:fontFamily="@font/regular"
        android:inputType="text"
        android:padding="@dimen/_12dp"
        android:textColor="@color/white"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="@dimen/_16sp"
        app:drawableEndCompat="@drawable/ic_navigate_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_album" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_34dp"
        android:fontFamily="@font/bold"
        android:text="@string/choose_type"
        android:textSize="@dimen/_26sp"
        app:layout_constraintStart_toStartOf="@id/tv_album"
        app:layout_constraintTop_toBottomOf="@id/edt_album" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/edt_choose_type"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginHorizontal="@dimen/_25dp"
        android:layout_marginTop="@dimen/_10dp"
        android:background="@drawable/edittext_background"
        android:fontFamily="@font/regular"
        android:gravity="top"
        android:inputType="text"
        android:padding="@dimen/_12dp"
        android:textColor="@color/white"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="@dimen/_16sp"
        app:drawableEndCompat="@drawable/ic_navigate_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_type" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_singer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_34dp"
        android:fontFamily="@font/bold"
        android:text="@string/choose_singer"
        android:textSize="@dimen/_26sp"
        app:layout_constraintStart_toStartOf="@id/tv_album"
        app:layout_constraintTop_toBottomOf="@id/edt_choose_type" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/edt_choose_singer"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginHorizontal="@dimen/_25dp"
        android:layout_marginTop="@dimen/_10dp"
        android:background="@drawable/edittext_background"
        android:fontFamily="@font/regular"
        android:gravity="top"
        android:inputType="text"
        android:padding="@dimen/_12dp"
        android:textColor="@color/white"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="@dimen/_16sp"
        app:drawableEndCompat="@drawable/ic_navigate_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_singer" />

</androidx.constraintlayout.widget.ConstraintLayout>