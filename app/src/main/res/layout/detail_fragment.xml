<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.component.playlist.DetailFragment">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/_10dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="200dp"
        android:id="@+id/imv_playlist"
        android:layout_height="200dp"
        android:layout_marginTop="@dimen/_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        tools:src="@tools:sample/avatars" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_marginStart="18dp"
        android:id="@+id/tv_playlist_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/demi"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="@id/btn_back"
        app:layout_constraintTop_toBottomOf="@id/imv_playlist"
        tools:text="Playlist Name " />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/demi"
        android:text="@string/description"
        android:textColor="@color/dusty_gray"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_playlist_name"
        app:layout_constraintTop_toBottomOf="@id/tv_playlist_name" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_download"
        app:layout_constraintStart_toStartOf="@id/tv_playlist_name"
        app:layout_constraintTop_toBottomOf="@id/tv_des" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_more_small"
        app:layout_constraintBottom_toBottomOf="@id/btn_download"
        app:layout_constraintStart_toEndOf="@id/btn_download"
        app:layout_constraintTop_toTopOf="@id/btn_download" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:layout_marginEnd="18dp"
        android:id="@+id/btn_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_play_green"
        app:layout_constraintBottom_toBottomOf="@id/btn_download"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_download" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcy_songs"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_add_more_item"
        tools:listitem="@layout/item_song" />

    <LinearLayout

        android:id="@+id/btn_add_more_item"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="18dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/rcy_songs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_download">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imv_add"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="#313130"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_add_small"
            app:shapeAppearanceOverlay="@style/rounded_corner" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_name_song"
            style="@style/TextMedium"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/_15dp"
            android:text="@string/add_to_this_playlist"
            />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>