<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.component.admin.song.add_song.step.Step1Fragment">



    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/bold"
        android:text="@string/song_name"
        android:textSize="@dimen/_26sp"
        android:layout_marginStart="@dimen/_24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imv_avatar" />


    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edt_song_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_25dp"
        android:layout_marginTop="@dimen/_10dp"
        android:background="@drawable/edittext_background"
        android:fontFamily="@font/regular"
        android:inputType="text"
        android:padding="@dimen/_12dp"
        android:textColor="@color/white"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="@dimen/_16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_name" />


    <com.google.android.material.imageview.ShapeableImageView
        android:layout_marginTop="@dimen/_20dp"
        android:id="@+id/imv_avatar"
        android:layout_width="@dimen/_123dp"
        android:layout_height="@dimen/_123dp"
        android:src="@drawable/song"
        android:theme="@style/rounded_corner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/pg_loading_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@id/imv_avatar"
        app:layout_constraintEnd_toEndOf="@id/imv_avatar"
        app:layout_constraintStart_toStartOf="@id/imv_avatar"
        app:layout_constraintTop_toTopOf="@id/imv_avatar" />


    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_edit"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_edit_circle"
        app:layout_constraintBottom_toBottomOf="@id/imv_avatar"
        app:layout_constraintEnd_toEndOf="@id/imv_avatar" />






</androidx.constraintlayout.widget.ConstraintLayout>