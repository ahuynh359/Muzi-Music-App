<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.component.activity.main.setting.SettingFragment">


    <com.google.android.material.imageview.ShapeableImageView
        android:layout_marginTop="20dp"
        android:id="@+id/imv_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="123dp"
        android:layout_height="123dp"
        android:src="@drawable/one_direction"
        android:theme="@style/circle" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_21dp"
        android:fontFamily="@font/bold"
        tools:text="AH"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="@id/imv_avatar"
        app:layout_constraintStart_toStartOf="@id/imv_avatar"
        app:layout_constraintTop_toBottomOf="@id/imv_avatar" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_edit"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:src="@drawable/ic_edit_circle"
        app:layout_constraintBottom_toBottomOf="@id/imv_avatar"
        android:layout_width="wrap_content"
        app:layout_constraintEnd_toEndOf="@id/imv_avatar" />


    <androidx.appcompat.widget.AppCompatButton
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:id="@+id/btn_log_out"
        android:textAllCaps="false"
        android:text="Log out"
        android:background="@drawable/btn_round_transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>




</androidx.constraintlayout.widget.ConstraintLayout>