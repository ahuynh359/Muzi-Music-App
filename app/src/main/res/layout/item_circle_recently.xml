<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingVertical="20dp"
    android:paddingHorizontal="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="@dimen/_123dp"
        android:layout_height="@dimen/_123dp"
        android:src="@drawable/one_direction"
        android:theme="@style/circle" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_marginTop="@dimen/_16sp"
        app:layout_constraintTop_toBottomOf="@id/imv"
        app:layout_constraintEnd_toEndOf="@id/imv"
        app:layout_constraintStart_toStartOf="@id/imv"
        android:id="@+id/tv_name"
        android:fontFamily="@font/demi"
        android:textSize="12sp"
        tools:text="Lama Del Rey"
        app:layout_constraintStart_toEndOf="@id/imv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>