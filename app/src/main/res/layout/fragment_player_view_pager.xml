<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/bg_gardient"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.component.player.PlayerActivity">


    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_down"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="@dimen/_22dp"
        android:layout_marginTop="30dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_down"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView

        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/tv_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bold"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/btn_down"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_down"
        tools:text="1(Remastered)" />

    <androidx.appcompat.widget.AppCompatTextView
        app:layout_constraintEnd_toEndOf="@id/tv_type"
        android:id="@+id/tv_singer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/medium"
        android:textColor="#B3B3B3"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/tv_type"
        app:layout_constraintTop_toBottomOf="@id/tv_type"
        tools:text="The Beatles" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_more"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="@dimen/_22dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_more"
        app:layout_constraintBottom_toBottomOf="@id/btn_down"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_down" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_marginTop="15dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:id="@+id/dot_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/dot_selected"
        app:layout_constraintEnd_toStartOf="@id/dot_2"
        app:layout_constraintStart_toStartOf="@id/tv_singer"
        app:layout_constraintTop_toBottomOf="@id/tv_singer" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_marginTop="15dp"
        android:layout_marginStart="5dp"
        android:id="@+id/dot_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/dot_default"
        app:layout_constraintEnd_toEndOf="@id/tv_singer"
        app:layout_constraintStart_toEndOf="@id/dot_1"
        app:layout_constraintTop_toBottomOf="@id/tv_singer" />
    <androidx.viewpager2.widget.ViewPager2
        android:layout_marginTop="@dimen/_20dp"
        app:layout_constraintTop_toBottomOf="@id/dot_1"
        app:layout_constraintEnd_toEndOf="@id/btn_more"
        app:layout_constraintStart_toStartOf="@id/btn_down"
        android:id="@+id/view_pager"
        android:layout_width="@dimen/_0dp"
        android:layout_height="420dp" />
    <com.chibde.visualizer.LineVisualizer
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/view_pager"
        app:layout_constraintEnd_toEndOf="@id/btn_more"
        app:layout_constraintStart_toStartOf="@id/btn_down"
        android:id="@+id/visualizer"
        android:layout_width="0dp"
        android:layout_height="50dp"/>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_marginHorizontal="@dimen/_20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/btn_sleep"
        android:id="@+id/shimmer_slider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include layout="@layout/item_slider_seekbar" />
    </com.facebook.shimmer.ShimmerFrameLayout>




    <androidx.appcompat.widget.AppCompatImageButton
        android:background="@android:color/transparent"
        android:id="@+id/btn_sleep"
        android:layout_marginStart="@dimen/_20dp"
        app:layout_constraintTop_toBottomOf="@id/visualizer"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_sleep"
        android:layout_width="@dimen/_30sp"
        android:layout_height="@dimen/_50dp"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:background="@android:color/transparent"
        android:id="@+id/btn_headphone"
        app:layout_constraintBottom_toBottomOf="@id/btn_sleep"
        app:layout_constraintStart_toEndOf="@id/btn_sleep"
        app:layout_constraintTop_toTopOf="@id/btn_sleep"
        android:src="@drawable/ic_tune"
        android:layout_width="@dimen/_50dp"
        android:layout_height="@dimen/_50dp"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:background="@android:color/transparent"
        android:id="@+id/btn_comment"
        app:layout_constraintBottom_toBottomOf="@id/btn_sleep"
        app:layout_constraintStart_toEndOf="@id/btn_headphone"
        app:layout_constraintTop_toTopOf="@id/btn_sleep"
        android:src="@drawable/ic_comment"
        android:layout_width="@dimen/_50dp"
        android:layout_height="@dimen/_50dp"/>


    <androidx.appcompat.widget.AppCompatImageButton
        android:background="@android:color/transparent"
        android:id="@+id/btn_heart"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_sleep"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_sleep"
        android:src="@drawable/ic_heart_small"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
    <com.google.android.material.slider.Slider
        android:visibility="invisible"
        app:thumbRadius="5dp"
        android:layout_marginHorizontal="@dimen/_20dp"
        android:layout_marginTop="16dp"
        android:id="@+id/slider"
        style="@style/CustomSlider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/btn_sleep"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:trackHeight="4dp" />

    <androidx.appcompat.widget.AppCompatTextView
        app:layout_constraintTop_toBottomOf="@id/slider"
        android:layout_marginBottom="40dp"
        android:id="@+id/tv_start_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/medium"
        android:textColor="#B2B2B2"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/slider"
        tools:text="00:00" />

    <androidx.appcompat.widget.AppCompatTextView

        android:id="@+id/tv_end_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/medium"
        android:textColor="#B2B2B2"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/slider"
        app:layout_constraintTop_toTopOf="@id/tv_start_time"
        tools:text="N:N" />


    <androidx.appcompat.widget.AppCompatImageButton
        app:layout_constraintTop_toBottomOf="@id/tv_start_time"
        android:id="@+id/btn_shuffle"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/_10dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_shuffle"
        app:layout_constraintStart_toStartOf="@id/btn_down"
        />
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_pre"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/btn_shuffle"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_pre"
        app:layout_constraintBottom_toBottomOf="@id/btn_shuffle"
        app:layout_constraintStart_toEndOf="@id/btn_shuffle"
        app:layout_constraintEnd_toStartOf="@id/btn_play_pause"
        />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_play_pause"
        android:layout_width="67dp"
        android:layout_height="67dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_play"
        app:layout_constraintBottom_toBottomOf="@id/btn_shuffle"
        app:layout_constraintEnd_toStartOf="@id/btn_next"
        app:layout_constraintStart_toEndOf="@id/btn_pre"
        app:layout_constraintTop_toTopOf="@id/btn_shuffle" />


    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_next"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_next"
        app:layout_constraintBottom_toBottomOf="@id/btn_shuffle"
        app:layout_constraintEnd_toStartOf="@id/btn_repeat"
        app:layout_constraintStart_toEndOf="@id/btn_play_pause"
        app:layout_constraintTop_toTopOf="@id/btn_shuffle" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_repeat"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_repeat"
        app:layout_constraintBottom_toBottomOf="@id/btn_shuffle"
        app:layout_constraintEnd_toEndOf="@id/btn_more"
        app:layout_constraintTop_toTopOf="@id/btn_shuffle" />


</androidx.constraintlayout.widget.ConstraintLayout>
