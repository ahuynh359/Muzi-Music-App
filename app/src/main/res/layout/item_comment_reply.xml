<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:focusable="true"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv_avatar_reply"
        android:layout_width="@dimen/_58dp"
        android:layout_height="@dimen/_58dp"
        android:src="@drawable/one_direction"
        android:theme="@style/circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_name_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="@dimen/_12dp"
        android:fontFamily="@font/bold"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/tv_content"
        app:layout_constraintStart_toEndOf="@id/imv_avatar_reply"
        app:layout_constraintTop_toTopOf="@id/imv_avatar_reply"
        tools:text="ahuynh" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_content_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/medium"
        android:text="Good song"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/imv_avatar_reply"
        app:layout_constraintStart_toStartOf="@id/tv_name_reply"
        app:layout_constraintTop_toBottomOf="@id/tv_name_reply" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/medium"
        android:text="•"
        android:textColor="#797777"
        android:textSize="13sp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@id/tv_name_reply"
        app:layout_constraintStart_toEndOf="@id/tv_name_reply"
        app:layout_constraintTop_toTopOf="@id/tv_name_reply" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_marginStart="5dp"
        android:id="@+id/tv_time_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/medium"
        android:text="13 minutes ago"
        android:textColor="#B3B3B3"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_name_reply"
        app:layout_constraintStart_toEndOf="@id/circle"
        app:layout_constraintTop_toTopOf="@id/tv_name_reply" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_more_reply"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_more_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/imv_avatar_reply"
        app:layout_constraintTop_toTopOf="@id/imv_avatar_reply" />

</androidx.constraintlayout.widget.ConstraintLayout>