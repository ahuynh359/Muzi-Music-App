<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:padding="@dimen/_10dp">


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imv_user"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/custom_bg_square"
        android:src="@drawable/one_direction"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:fontFamily="@font/medium"
        android:textSize="15sp"

        app:layout_constraintBottom_toBottomOf="@id/imv_user"
        app:layout_constraintStart_toEndOf="@id/imv_user"
        app:layout_constraintTop_toTopOf="@id/imv_user"
        tools:text="AnhHuynh" />



</androidx.constraintlayout.widget.ConstraintLayout>