<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:paddingVertical="20dp"
    android:paddingHorizontal="10dp"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/imv"
        android:layout_width="@dimen/_153dp"
        android:layout_height="@dimen/_153dp"
        android:background="@drawable/custom_bg_gray_round"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_marginTop="12dp"
        android:id="@+id/tv_name_song"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_bg_gray_round"
        app:layout_constraintEnd_toEndOf="@id/imv"
        app:layout_constraintStart_toStartOf="@id/imv"
        app:layout_constraintTop_toBottomOf="@id/imv" />
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_marginTop="5dp"
        android:id="@+id/tv_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_bg_gray_round"
        app:layout_constraintEnd_toEndOf="@id/imv"
        app:layout_constraintStart_toStartOf="@id/imv"
        app:layout_constraintTop_toBottomOf="@id/tv_name_song" />

</androidx.constraintlayout.widget.ConstraintLayout>