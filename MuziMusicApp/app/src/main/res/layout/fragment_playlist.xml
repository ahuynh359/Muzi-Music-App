<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.component.playlist.PlaylistFragment">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_a_z"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_15dp"
        android:layout_marginTop="@dimen/_20dp"
        android:drawableStart="@drawable/ic_sort"
        android:fontFamily="@font/bold"
        android:text="@string/a_z"
        android:textSize="@dimen/_12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_15dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_add"
        android:text="@string/recents"
        app:layout_constraintBottom_toBottomOf="@id/btn_a_z"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_a_z" />

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_playlist"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:layout_marginTop="@dimen/_14dp"
        app:layout_constraintBottom_toTopOf="@id/player"
        app:layout_constraintEnd_toEndOf="@id/btn_add"
        app:layout_constraintStart_toStartOf="@id/btn_a_z"
        app:layout_constraintTop_toBottomOf="@id/btn_a_z">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_shimmer_round" />

            <include layout="@layout/item_shimmer_round" />

            <include layout="@layout/item_shimmer_round" />

            <include layout="@layout/item_shimmer_round" />

            <include layout="@layout/item_shimmer_round" />

            <include layout="@layout/item_shimmer_round" />

            <include layout="@layout/item_shimmer_round" />

            <include layout="@layout/item_shimmer_round" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcy_playlist"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        android:layout_marginTop="@dimen/_14dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/player"
        app:layout_constraintEnd_toEndOf="@id/btn_add"
        app:layout_constraintStart_toStartOf="@id/btn_a_z"
        app:layout_constraintTop_toBottomOf="@id/btn_a_z"
        tools:listitem="@layout/item_song" />

    <include
        android:visibility="gone"
        android:id="@+id/player"
        android:layout_marginBottom="@dimen/_5dp"
        android:layout_marginHorizontal="@dimen/_7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        layout="@layout/item_player"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
