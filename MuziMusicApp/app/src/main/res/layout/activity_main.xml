<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">



    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="@dimen/_0dp"
        android:layout_height="@dimen/_0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/btm_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:name="androidx.navigation.fragment.NavHostFragment"
        app:navGraph="@navigation/main_graph">

    </androidx.fragment.app.FragmentContainerView>


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/btm_navigation"
        android:background="@color/black"
        style="@style/Widget.MaterialComponents.BottomNavigationView.PrimarySurface"
        android:layout_width="@dimen/_0dp"
        android:layout_height="wrap_content"
        app:itemIconTint="@drawable/custom_bottom_nav_icon"
        app:itemRippleColor="@color/white"
        app:itemTextColor="@drawable/custom_bottom_nav_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fragment_container"
        app:menu="@menu/btm_menu" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:visibility="gone"
        android:layout_marginHorizontal="5dp"
        android:padding="@dimen/_10dp"
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/custom_bg_square"
        app:layout_constraintBottom_toTopOf="@id/btm_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imv_song"
            android:layout_width="@dimen/_38dp"
            android:layout_height="@dimen/_38dp"
            android:background="@drawable/custom_bg_square"
            android:src="@drawable/one_direction"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_song"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10dp"
            android:fontFamily="@font/medium"
            android:textSize="13sp"
            app:layout_constraintBottom_toTopOf="@id/tv_singer"
            app:layout_constraintStart_toEndOf="@id/imv_song"
            app:layout_constraintTop_toTopOf="@id/imv_song"
            tools:text="Easy" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_singer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/medium"
            android:textColor="#B3B3B3"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/imv_song"
            app:layout_constraintStart_toStartOf="@id/tv_song"
            app:layout_constraintTop_toBottomOf="@id/tv_song"
            tools:text="Troye Sivan" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_pre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_20dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_pre_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_play_pause"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_20dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_pause_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_next"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_20dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_next_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.slider.Slider
        android:visibility="gone"
        style="@style/CustomSlider"
        android:id="@id/slider"
        android:layout_width="@dimen/_0dp"
        android:layout_height="2dp"
        android:padding="@dimen/_0dp"
        android:thumb="@drawable/thumb_trans"
        app:haloRadius="@dimen/_0dp"
        app:layout_constraintBottom_toTopOf="@id/btm_navigation"
        app:layout_constraintEnd_toEndOf="@id/player"
        app:layout_constraintStart_toStartOf="@id/player"
        app:layout_constraintTop_toBottomOf="@id/player"
        app:thumbRadius="@dimen/_0dp"
        app:trackHeight="2dp" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_send"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/btn_round_green"
        android:src="@drawable/ic_navigate_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.044"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.954"
        app:tint="@color/black" />


</androidx.constraintlayout.widget.ConstraintLayout>